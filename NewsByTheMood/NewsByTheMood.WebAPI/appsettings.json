{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.log",
          "fileSizeLimitBytes": 1073741824,
          "retainedFileCountLimit": 31,
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "NewsByTheMood"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=DESKTOP-P7UGVUT;Database=NewsByTheMoodDB;Trusted_Connection=True;TrustServerCertificate=True;",
    "Default1": "Server=IT02331;Database=NewsByTheMoodDB-Test;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*"
}
