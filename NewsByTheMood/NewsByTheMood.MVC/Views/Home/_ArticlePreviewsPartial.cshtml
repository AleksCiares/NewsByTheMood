@addTagHelper NewsByTheMood.MVC.TagHelpers.PositivityIconTagHelper, NewsByTheMood.MVC
@model IEnumerable<ArticlePreviewModel>

<div class="articles__list row justify-content-start row-cols-1 row-cols-sm-1 row-cols-md-2 
    row-cols-lg-2 row-cols-xl-3 row-cols-xxl-3">
@foreach (var articlePreview in Model)
{
    <div class="article__preview col mb-4">
        <div class="article__card card bg-dark text-white rounded-5" style="background-image: url(@articlePreview.PreviewImgUrl)">
            <div class="card-body d-flex align-content-between flex-wrap">
                <div class="w-100">
                    <div class="d-flex justify-content-between mb-auto">
                        <span>@articlePreview.TopicName</span>
                        <span>@articlePreview.PublishDate?.ToString("f")</span>
                    </div>
                </div>
                <div class="w-100">
                    <a asp-area="" asp-controller="home" asp-action="detail" asp-route-id="@articlePreview.Id"
                       class="card-title text-decoration-none mb-2">
                        <h5>@articlePreview.Title</h5>
                    </a>
                    <div class="d-flex justify-content-between mb-2">
                        <div>
                            <positivity-icon positivity="@articlePreview.Positivity" use-css-tooltip="true"/>
                        </div>
                        <div>
                            <a href="@articlePreview.SourceUrl" class="text-decoration-none">
                                @articlePreview.SourceName
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
</div>