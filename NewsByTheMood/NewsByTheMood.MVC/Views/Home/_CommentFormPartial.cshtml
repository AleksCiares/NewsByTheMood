@addTagHelper NewsByTheMood.MVC.TagHelpers.DynamicTextAreaTagHelper, NewsByTheMood.MVC
@model CommentCreateModel

<div class="user-form__wrap">
    <form asp-antiforgery="true" asp-area="" asp-controller="home" asp-action="addcommenttoarticle"
          method="post" id="userForm" class="user-form">
        <div class="user-form__text-wrap">
            <dynamic-text-area asp-for="@Model.Text" text-area-selector="user-form__text" rows="3"
                               max-rows="15" class="form-control pb-5" placeholder="Type your comment...">
             </dynamic-text-area>
            <button type="submit" class="btn">
                <i class="bi bi-send"></i>
            </button>
        </div>
        <div class="d-flex justify-content-center">
            <span style="width:auto" asp-validation-for="@Model.Text" class="error-feedback invalid-feedback"></span>
        </div>
    </form>
</div>