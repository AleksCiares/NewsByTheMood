@model IEnumerable<CommentModel>

@foreach (var comment in Model)
{
    <div class="comment mb-3">
        <div class="comment__header d-flex justify-content-between bg-transparent">
            <div class="d-flex justify-content-start align-items-center">
                <img src="@comment.UserAvatar" class="user-avatar rounded-circle border" />
                 <span >@comment.UserDisplayName</span>
            </div>
            <div>
                <span>@comment.PublishDate.ToString("dd.mm.yyyy HH:mm")</span>
            </div>
        </div>
        <div class="comment__body">@comment.Text</div>
    </div>
}
