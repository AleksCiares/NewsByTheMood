@model NewsByTheMood.MVC.Models.ArticleModel
@{
    ViewData["PageTitle"] = Model.Title;
}

<div class="article container">
    <div class="row justify-content-center align-content-start mb-4">
        <div class="container col-8">
            <div class="article__title row mb-3">
                <h3>@Model.Title</h3>
            </div>
            @if (Model.PreviewImgUrl != null)
            {
                <div class="article__preview-img row rounded mb-3">
                    <div class="article__preview-img-wrap">
                        <img src="@Model.PreviewImgUrl" alt="@Model.Title">
                        <div class="overlay bottom-0 start-0 w-100 p-2 text-white">
                            <div class="d-flex justify-content-between">
                                <div>
                                    @switch (Model.Positivity)
                                    {
                                        case 10:
                                        case 9:
                                            <i class="bi bi-emoji-smile" style="color: limegreen;"></i>
                                            break;

                                        case 8:
                                        case 7:
                                            <i class="bi bi-emoji-smile" style="color: yellowgreen;"></i>
                                            break;

                                        case 6:
                                        case 5:
                                            <i class="bi bi-emoji-neutral" style="color: orange;"></i>
                                            break;

                                        case 4:
                                        case 3:
                                            <i class="bi bi-emoji-frown" style="color: orangered;"></i>
                                            break;

                                        case 2:
                                        case 1:
                                            <i class="bi bi-emoji-frown" style="color: red;"></i>
                                            break;

                                        default:
                                            <i class="bi bi-emoji-tear" style="color: antiquewhite"></i>
                                            break;
                                    }
                                    <span>@Model.PublishDate</span>
                                </div>
                                <div>
                                    <span>@Model.TopicName</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="article__body row mb-3">
                @Html.Raw(@Model.Body)
            </div>
            <div class="article__source row align-items-center justify-content-end mb-3">
                <div class="col-auto">
                    <a href="@Model.Url" target="_blank" class="text-decoration-none">@Model.SourceName</a>
                </div>
            </div>
            <div class="article__tags row align-items-center justify-content-start mb-3">
                @foreach (var tag in Model.Tags)
                {
                    <div class="col-auto mb-2">
                        <div class="border rounded-3">
                            <span class="mx-1">@tag</span>
                        </div>
                    </div>
                }
            </div>
            <div class="article__comments">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-antiforgery="true" method="post" id="addCommentForm">
                        <textarea name="Text" class="form-control" id="commentForm" placeholder="Type your comment..." rows="5"
                            style="resize:none; overflow: hidden;"></textarea>
                        <span class="error-feedback invalid-feedback"></span>
                        <button type="submit" class="btn btn-outline-primary">Submit</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Footer
{
    <partial name="_FooterPartial" />
}

@section Scripts
{
   <script>
        document.addEventListener("DOMContentLoaded", function () {
            var textarea = document.querySelector('#commentForm');
            if (textarea) {
                textarea.style.height = 'auto';
                textarea.style.height = (textarea.scrollHeight) + 'px';

                textarea.addEventListener('input', function () {
                    this.style.height = 'auto';
                    this.style.height = (this.scrollHeight) + 'px';
                });
            }

            $('#addCommentForm').on('submit', function (e) {
                e.preventDefault();

                $.ajax({
                    url: '/Home/AddComment/1',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            // Обновить список комментариев или выполнить другие действия
                        } else {
                            if (response.errors) {
                                alert('Validation errors: ' + response.errors.join(', '));
                            } else {
                                alert(response.message);
                            }
                        }
                    },
                    error: function () {
                        alert('An unexpected error occurred. Please try again later.');
                    }
                });
            });
        });
   </script>
}



