@addTagHelper NewsByTheMood.MVC.TagHelpers.PositivityIconTagHelper, NewsByTheMood.MVC
@addTagHelper NewsByTheMood.MVC.TagHelpers.SectionDividerTagHelper, NewsByTheMood.MVC
@model NewsByTheMood.MVC.Models.ArticleModel
@{
    ViewData["PageTitle"] = Model.Title;
}

<div class="article container">
    <div class="row justify-content-center align-content-start mb-4">
        <div class="col-8">
            <div class="article__title mb-3">
                <h3>@Model.Title</h3>
            </div>
            <div class="article__preview-img rounded mb-3">
                @if (Model.PreviewImgUrl != null)
                {
                    <img src="@Model.PreviewImgUrl" alt="@Model.Title">
                }
                <div class="overlay d-flex justify-content-between align-items-center w-100">
                    <div>
                        <positivity-icon positivity="@Model.Positivity"/>
                        <span>@Model.PublishDate</span>
                    </div>
                    <div>
                        <span>@Model.TopicName</span>
                    </div>
                </div>
            </div>
            <div class="article__body mb-3">
                @Html.Raw(@Model.Body)
            </div>
            <div class="article__source d-flex align-items-center justify-content-end mb-3">
                <div>
                    <a href="@Model.Url" target="_blank" class="text-decoration-none">@Model.SourceName</a>
                </div>
            </div>
            @if (Model.Tags.Length > 0)
            {
                <div class="article__tags d-flex align-items-center justify-content-start mb-3">
                    @foreach (var tag in Model.Tags)
                    {
                        <div class="pe-2 mb-2">
                            <div class="border rounded-3">
                                <span class="mx-1">@tag</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="row justify-content-center align-content-start mb-4">
        <div class="col-8">
            <div class="article__comments">
                <section-divider>Comments</section-divider>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="comments-form mb-3">
                        <partial name="_CommentFormPartial" model="new CommentCreateModel()" />
                    </div>
                }
                <div class="comments-container">
                    <partial name="_AsyncLoadItemsPartial" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Footer
{
    <partial name="_FooterPartial" />
}

@section Scripts
{
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <partial name="_ValidationScriptsPartial" />
        <script src="~/js/user-form.js" asp-append-version="true"></script>
    }
    <script src="~/js/async-load-items.js" asp-append-version="true"></script>
    <script>
        var asyncLoadUrl = "/getcomments";
        var asyncLoadMethod = "POST";
    </script>
}



