@model string[]

@if(Model.Length > 0)
{
	<div class="icons-bar mb-3">
		<div class="container-fluid" style="padding-left: 0; padding-right: 0;">
			<div class="d-flex mb-3">
				<h4 class="mb-0">Icons library</h4>
			</div>
			<div class="icons-search mb-3">
				<input type="text" id="iconSearch" class="form-control" placeholder="Search icons..." />
			</div>
			<div class="row row-cols-10 row-cols-sm-12">
				@foreach (var iconClass in Model)
				{
					<div class="col mb-4 rounded icon-item-wrap">
						<div class="icon-item card text-center" value="@iconClass">
							<div class="card-body">
								<i class="fs-4 @iconClass"></i>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			var iconSearch = document.getElementById('iconSearch');
			var iconItems = document.querySelectorAll('.icon-item-wrap');

			iconSearch.addEventListener('input', function () {
				var filter = iconSearch.value.toLowerCase();
				iconItems.forEach(function (item) {
					var icon = item.querySelector(".icon-item").getAttribute("value").toLowerCase();
					if (icon.includes(filter)) {
						item.style.display = '';
					} else {
						item.style.display = 'none';
					}
				});
			});
		});
	</script>
}

