@model HeaderModel

<header class="sticky-top mb-5">
    <nav class="header navbar navbar-expand-sm shadow-sm rounded">
        <div class="container-fluid justify-content-between">
            <div class="col-auto">
                <a class="navbar-brand" asp-area="" asp-controller="home" asp-action="index">
                    <img src="~/images/newsbythemood-logo.webp" alt="NewsByTheMood" style="width: 50px; height: 50px;" />
                </a>
            </div>
            <div class="col-auto">
                <button class="navbar-toggler text-center" type="button" data-bs-toggle="collapse" data-bs-target="#headerNavBar"
                aria-controls="headerNavBar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon">
                        <i class="bi bi-grid-fill"></i>
                    </span>
                </button>
                <div class="navbar-collapse collapse" id="headerNavBar">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a asp-area="" asp-controller="home" asp-action="index" class="nav-link @(ViewContext.HttpContext.Request.Path.ToString().ToLower() == "/" ? "active" : "")">
                                Latest
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="headerNavBarTopics" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Topics
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="headerNavBarTopics">
                                @foreach (var topic in Model.Topics)
                                {
                                    <li>
                                        <a asp-area="" asp-controller="home" asp-action="topic" asp-route-id="@topic.Name" class="dropdown-item">
                                            <i class="fs-4 @topic.IconCssClass"></i>
                                            <span class="ms-1 d-none d-xl-inline">
                                                @topic.Name
                                            </span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="home" asp-action="favorites" class="nav-link @(ViewContext.HttpContext.Request.Path.ToString().ToLower() == "/favorites" ? "active" : "")">
                                Favorite
                            </a> @*по настройкам пользователя*@
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-auto">
                @if (Model.UserPreview != null)
                {
                    <div class="user-avatar-container position-relative">
                        <img src="@Model.UserPreview.AvatarUrl" alt="@Model.UserPreview.DisplayedName" class="user-avatar rounded-circle border" id="userAvatar" />
                        <div class="user-settings-menu position-fixed top-0 end-0 bg-light shadow-lg p-3" id="userSettingsMenu">
                            <div class="row justify-content-between flex-nowrap">
                                <div class="col-auto">
                                    <div>@Model.UserPreview.DisplayedName</div>
                                    <div class="text-muted">@Model.UserPreview.UserName</div>
                                </div>
                                <div class="col-auto">
                                    <button type="button" class="btn-close" aria-label="Close" id="closeSettingsMenu"></button>
                                </div>
                            </div>
                            <hr />
                            <ul class="list-unstyled mt-3">
                                <li>
                                    <a asp-area="identity" asp-page="/account/manage/index" class="text-dark text-decoration-none">Manage account</a>
                                </li>
                                <hr />
                                @if (User.IsInRole(AccessLevels.Editor))
                                {
                                    <li>
                                        <a asp-area="settings" asp-controller="articles" asp-action="index" class="text-dark text-decoration-none">Articles editor</a>
                                    </li>
                                    <hr />
                                }
                                @if (User.IsInRole(AccessLevels.Admininistrator))
                                {
                                    <li>
                                        <a asp-area="settings" asp-controller="main" asp-action="index" class="text-dark text-decoration-none">Server settings</a>
                                    </li>
                                    <hr />
                                }
                                <li>
                                    <form asp-area="identity" asp-page="/account/logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                        <button type="submit" class="btn btn-link text-dark text-decoration-none" style="padding: 0px">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <div class="navbar-collapse">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/account/login">Sign in</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/account/register">Sign up</a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </nav>
    <script src="~/js/header.js" asp-append-version="true"></script>
</header>
