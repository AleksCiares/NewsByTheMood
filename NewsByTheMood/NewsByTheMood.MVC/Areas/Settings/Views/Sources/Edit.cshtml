@model SourceSettingsModel
@{
	ViewData["PageTitle"] = $"{Model.Name} - Editing";
}

<div class="source container">
	<div class="source__header d-flex row mb-5">
		<h4 class="mb-0">Edit source @Model.Name</h4>
	</div>
	<form asp-antiforgery="true" asp-area="settings" asp-controller="sources" asp-action="edit" method="post" 
		id="sourceForm" class="source-form">
		<div class="form__panel row align-items-start justify-content-between mb-4">
			<div class="col-auto">
				<button id="sourceFormSubmit" type="submit" class="btn btn-primary">Save</button>
				<a asp-area="settings" asp-controller="sources" asp-action="index" class="btn btn-secondary">Cancel</a>
				<a asp-area="settings" asp-controller="articlesload" asp-action="loadbysourcemanually" 
				asp-route-id="@Model.Id" id="loadArticlesButton" class="btn btn-primary">
					Load articles
					<span id="reloadSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
				</a>
			</div>
			<div class="col-auto">
				<a asp-area="settings" asp-controller="sources" asp-action="delete" asp-route-id="@Model.Id" 
				id="deleteSourceButton" class="btn btn-danger">Delete</a>
			</div>
		</div>
		@* <div class="d-flex justify-content-start">
			<span class="text-muted">Source has @(Model.RelatedArticles) related articles</span>
		</div> *@
		<partial name="_SourceFormPartial" model="@Model" />
	</form>
</div>

@section Scripts 
{
	<script src="~/js/CommonForm.js" asp-append-version="true"></script>
	<script src="~/js/CommonModal.js" asp-append-version="true"></script>
	<script src="~/js/send-async-request.js" asp-append-version="true"></script>
	<script src="~/js/settings/sources/settings-sources-edit.js" asp-append-version="true"></script>
	@if (Model.RelatedArticles > 0)
	{
		<script>
			const deleteModal = new CommonModal(
				'Delete source',
				'Can not delete a source with related articles. Please delete related articles first.',
				'deleteSourceButton'
			);

			deleteModal.setCancelButton('Cancel', 'btn-secondary');
		</script>
	}
	else
	{
	<script>
		const deleteModal = new CommonModal(
			'Delete source',
			'Are you sure to delete this source?',
			'deleteSourceButton'
		);

		deleteModal.setCancelButton('Cancel', 'btn-secondary');
		deleteModal.setConfirmButton('Confirm', 'btn-danger', async () =>
		{
			const href = document.getElementById('deleteSourceButton').href;
			await sendAsyncRequest(href, 'POST', '/settings/sources/', showGeneralNotifyMessage);
		});
	</script>
	}
}