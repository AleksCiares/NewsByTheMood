@model SourceSettingsModel
@{
	ViewData["PageTitle"] = "Create a source";
}

<div class="source container">
	<div class="source__header d-flex row mb-5">
		<h4 class="mb-0">Create a source</h4>
	</div>
	<form asp-antiforgery="true" asp-area="settings" asp-controller="sources" asp-action="create" method="post" 
		id="sourceForm" class="source-form">
		<div class="form__panel row align-items-start justify-content-between mb-4">
			<div class="col-auto">
				<button id="sourceFormSubmit" type="submit" class="btn btn-primary">Save</button>
				<a asp-area="settings" asp-controller="sources" asp-action="index" class="btn btn-secondary">Cancel</a>
			</div>
		</div>
		<partial name="_SourceFormPartial" model="@Model" />
	</form>
</div>
@section Scripts {
	<script src="~/js/CommonForm.js" asp-append-version="true"></script>
	<script src="~/js/settings/sources/settings-sources-create.js" asp-append-version="true"></script>
}