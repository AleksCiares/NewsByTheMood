@model TopicSettingsModel
@{
	ViewData["PageTitle"] = $"{Model.Name} - Editing";
}

<div class="topic container">
	<div class="topic__header d-flex row mb-5">
		<h4 class="mb-0">Edit topic @Model.Name</h4>
	</div>
	<form asp-antiforgery="true" asp-area="settings" asp-controller="topics" asp-action="edit" method="post" 
		id="topicForm" class="topic-form">
		<div class="form__panel row align-items-start justify-content-between mb-4">
			<div class="col-auto">
				<button id="topicFormSubmit" type="submit" class="btn btn-primary">Save</button>
				<a asp-area="settings" asp-controller="topics" asp-action="index" class="btn btn-secondary">Cancel</a>
			</div>
			<div class="col-auto">
				<a asp-area="settings" asp-controller="topics" asp-action="delete" asp-route-id="@Model.Id" 
					id="deleteTopicButton" class="btn btn-danger">Delete</a>
			</div>
		</div>
		<partial name="_TopicFormPartial" model="@Model" />
	</form>
</div>

@section Scripts
{
	<script src="~/js/CommonForm.js" asp-append-version="true"></script>
	<script src="~/js/CommonModal.js" asp-append-version="true"></script>
	<script src="~/js/send-async-request.js" asp-append-version="true"></script>
	<script src="~/js/settings/topics/settings-topics-edit.js" asp-append-version="true"></script>
	@if (Model.RelatedSources > 0)
	{
		<script>
			const deleteModal = new CommonModal(
				'Delete topic',
				'Can not delete a topic with related sources. Please delete related sources first.',
				'deleteTopicButton'
			);

			deleteModal.setCancelButton('Cancel', 'btn-secondary');
		</script>
	}
	else
	{
		<script>
			const deleteModal = new CommonModal(
				'Delete topic',
				'Are you sure to delete this topic?',
				'deleteTopicButton'
			);

			deleteModal.setCancelButton('Cancel', 'btn-secondary');
			deleteModal.setConfirmButton('Confirm', 'btn-danger', async () =>
			{
				const href = document.getElementById('deleteTopicButton').href;
				await sendAsyncRequest(href, 'POST', '/settings/topics/', showGeneralNotifyMessage);
			});
		</script>
	}
}