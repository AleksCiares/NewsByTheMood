@addTagHelper NewsByTheMood.MVC.TagHelpers.SectionDividerTagHelper, NewsByTheMood.MVC
@model ArticleSettingsModel
@{
	ViewData["PageTitle"] = $"{Model.Title} - Editing";
}

<div class="article container">
	<div class="article__header d-flex row mb-5">
		<h4 class="mb-0">@Model.Title</h4>
	</div>
	<form asp-antiforgery="true" asp-area="settings" asp-controller="articles" asp-action="edit"
		  method="post" id="articleForm" class="article-from">
		<div class="form__panel row align-items-start justify-content-between mb-4">
			<div class="col-auto">
				<button type="submit" id="articleFormSubmit" class="btn btn-primary">Save</button>
				<a asp-area="settings" asp-controller="articles" asp-action="index" class="btn btn-secondary">Cancel</a>
				<a asp-area="settings" asp-controller="articlesload" asp-action="updatemanually"
					asp-route-id="@Model.Id" id="reloadArticleButton" class="btn btn-primary">
					Back to original
					<span id="reloadSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
				</a>
			</div>
			<div class="col-auto">
				<a asp-area="settings" asp-controller="articles" asp-action="delete" asp-route-id="@Model.Id" 
					id="deleteArticleButton" class="btn btn-danger">Delete</a>
			</div>
		</div>
		<partial name="_ArticleFormPartial" model="@Model" />
	</form>
	<div class="article__comments"> 
		<section-divider>Comments</section-divider>
		<div class="comments-container"> 
			<div class="d-flex justify-content-end mb-4">
				<button class="btn btn-danger" id="deleteSelectedComments">Delete selected</button>
			</div>
		 	<partial name="_AsyncLoadItemsPartial" /> 
		</div> 
	</div>
</div>

@section Scripts 
{
	<script src="~/js/CommonForm.js" asp-append-version="true"></script>
	<script src="~/js/CommonModal.js" asp-append-version="true"></script>
	<script src="~/js/send-async-request.js" asp-append-version="true"></script>
	<script src="~/js/async-load-items.js" asp-append-version="true"></script>
	<script src="~/js/settings/articles/settings-articles-edit.js" asp-append-version="true"></script>
	<script>
		var asyncLoadUrl = "/settings/articles/getcomments/@Model.Id";
		var asyncLoadMethod = "POST";
	</script>
}