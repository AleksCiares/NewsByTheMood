@model ArticleSettingsModel
@{
	ViewData["PageTitle"] = "Create a article";
}

<div class="article container">
	<div class="article__header d-flex row mb-5">
		<h4 class="mb-0">Create a article</h4>
	</div>
	<form asp-antiforgery="true" asp-area="settings" asp-controller="articles" asp-action="create"
		  method="post" id="articleForm" class="article-from">
		<div class="article-from__panel row align-items-start justify-content-between mb-4">
			<div class="col-auto">
				<button type="submit" class="btn btn-primary">Submit</button>
				<a asp-area="settings" asp-controller="articles" asp-action="index" class="btn btn-secondary">Cancel</a>
			</div>
		</div>
        <partial name="_ArticleFormPartial" model="@Model" />
	</form>
</div>

@section Scripts 
{
	<script src="~/js/common-form.js" asp-append-version="true"></script>
	<script>
		var commonForm_formId = 'articleForm';
		var commonForm_successMessage = 'Success create article. ';
		var commonForm_successRedirectUrl = '/settings/articles/';
        var commonForm_errorMessage = 'Error create article. ';
	</script>
}